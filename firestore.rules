rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Definition
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Auth Role validation (requires 'users' collection to act as the trusted source, created via Admin SDK or controlled creation)
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '64.iklas@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function getAssociatedPartnerId(uid) {
       let u = exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)).data : null;
       return u != null ? (u.role == 'partner' ? uid : u.partnerId) : null;
    }

    function isPartnerUser(partnerId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && getAssociatedPartnerId(request.auth.uid) == partnerId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'partner';
    }

    function isClientUser(clientId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clientId == clientId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client';
    }

    function isAppAdmin() {
       return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.size() >= 5 && data.size() <= 7 &&
        data.keys().hasAll(['role', 'name', 'email', 'createdAt', 'updatedAt']) &&
        data.role is string && (data.role == 'superadmin' || data.role == 'partner' || data.role == 'client') &&
        data.name is string && data.name.size() <= 150 &&
        data.email is string && data.email.size() <= 200 &&
        (!('partnerId' in data) || data.partnerId == null || (data.partnerId is string && data.partnerId.size() <= 128)) &&
        (!('clientId' in data) || data.clientId == null || (data.clientId is string && data.clientId.size() <= 128)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPartner(data) {
      return data.size() >= 5 && data.size() <= 6 &&
        data.keys().hasAll(['name', 'logoUrl', 'brandColor', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() <= 150 &&
        data.logoUrl is string && data.logoUrl.size() <= 500 &&
        data.brandColor is string && data.brandColor.size() <= 20 &&
        (!('fontFamily' in data) || data.fontFamily == null || (data.fontFamily is string && data.fontFamily.size() <= 100)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClient(data) {
      return data.size() >= 5 && data.size() <= 6 &&
        data.keys().hasAll(['partnerId', 'name', 'createdAt', 'updatedAt']) &&
        data.partnerId is string && data.partnerId.size() <= 128 &&
        data.name is string && data.name.size() <= 150 &&
        (!('contactEmail' in data) || data.contactEmail == null || (data.contactEmail is string && data.contactEmail.size() <= 200)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEvent(data) {
      return data.size() >= 7 && data.size() <= 14 &&
        data.keys().hasAll(['partnerId', 'clientId', 'title', 'date', 'status', 'createdAt', 'updatedAt']) &&
        data.partnerId is string && data.partnerId.size() <= 128 &&
        data.clientId is string && data.clientId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.date is string && data.date.size() <= 50 &&
        data.status is string && (data.status == 'draft' || data.status == 'published' || data.status == 'completed') &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 2000)) &&
        (!('location' in data) || data.location == null || (data.location is string && data.location.size() <= 500)) &&
        (!('digitalInviteLink' in data) || data.digitalInviteLink == null || (data.digitalInviteLink is string && data.digitalInviteLink.size() <= 2048)) &&
        (!('time' in data) || data.time == null || (data.time is string && data.time.size() <= 50)) &&
        (!('frameOverlayUrl' in data) || data.frameOverlayUrl == null || (data.frameOverlayUrl is string && data.frameOverlayUrl.size() <= 2048)) &&
        (!('guestCategories' in data) || data.guestCategories == null || (data.guestCategories is list && data.guestCategories.size() <= 50)) &&
        (!('primaryColor' in data) || data.primaryColor == null || (data.primaryColor is string && data.primaryColor.size() <= 20)) &&
        (!('fontFamily' in data) || data.fontFamily == null || (data.fontFamily is string && data.fontFamily.size() <= 100)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGuest(data) {
      return data.size() >= 7 && data.size() <= 12 &&
        data.keys().hasAll(['eventId', 'name', 'ticketCode', 'rsvpStatus', 'attended', 'createdAt', 'updatedAt']) &&
        data.eventId is string && data.eventId.size() <= 128 &&
        data.name is string && data.name.size() <= 150 &&
        data.ticketCode is string && data.ticketCode.size() <= 50 &&
        data.rsvpStatus is string && (data.rsvpStatus == 'pending' || data.rsvpStatus == 'attending' || data.rsvpStatus == 'declined') &&
        data.attended is bool &&
        (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
        (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 500)) &&
        (!('attendedAt' in data) || data.attendedAt == null || data.attendedAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChangelog(data) {
      return data.size() == 4 &&
        data.keys().hasAll(['version', 'date', 'changes', 'createdAt']) &&
        data.version is string && data.version.size() <= 50 &&
        data.date is string && data.date.size() <= 50 &&
        data.changes is list && data.changes.size() <= 20 &&
        (data.changes.size() == 0 || (data.changes[0] is string && data.changes[0].size() <= 500)) &&
        data.createdAt is timestamp;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      // Allow user creation by superadmins or if authenticated (but can't set role to superadmin unless done by function)
      allow create: if isSignedIn() && isValidUser(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (isSuperAdmin() || 
         (request.auth.uid == userId && incoming().role != 'superadmin') ||
         (isPartnerUser(incoming().partnerId) && incoming().role == 'client')
        );
      allow update: if isValidId(userId) && isSignedIn() && isValidUser(incoming()) && incoming().updatedAt == request.time &&
        (isSuperAdmin() || (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])));
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    match /partners/{partnerId} {
      allow get: if isValidId(partnerId) && isSignedIn(); // Users need to read partner branding
      allow list: if isSuperAdmin() || isAppAdmin();
      allow create: if isSuperAdmin() && isValidPartner(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(partnerId) && isValidPartner(incoming()) && incoming().updatedAt == request.time &&
        (isSuperAdmin() || isPartnerUser(partnerId));
      allow delete: if isValidId(partnerId) && isSuperAdmin();
    }

    match /clients/{clientId} {
      allow get: if isValidId(clientId) && (isSuperAdmin() || (isSignedIn() && isPartnerUser(existing().partnerId)));
      allow list: if isSuperAdmin() || (isSignedIn() && existing().partnerId == getAssociatedPartnerId(request.auth.uid));
      allow create: if isSignedIn() && isValidClient(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time && (isSuperAdmin() || isPartnerUser(incoming().partnerId));
      allow update: if isValidId(clientId) && isSignedIn() && isValidClient(incoming()) && incoming().updatedAt == request.time &&
        incoming().partnerId == existing().partnerId &&
        (isSuperAdmin() || isPartnerUser(existing().partnerId));
      allow delete: if isValidId(clientId) && (isSuperAdmin() || isPartnerUser(existing().partnerId));
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId); // Public can read event details for RSVP
      allow list: if isSuperAdmin() || isPartnerUser(existing().partnerId) || isClientUser(existing().clientId);
      // Event must be created by superadmin or partner
      allow create: if isSignedIn() && isValidEvent(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (isSuperAdmin() || isPartnerUser(incoming().partnerId));
      allow update: if isValidId(eventId) && isSignedIn() && isValidEvent(incoming()) && incoming().updatedAt == request.time &&
        incoming().partnerId == existing().partnerId &&
        (isSuperAdmin() || isPartnerUser(existing().partnerId) || isClientUser(existing().clientId));
      allow delete: if isValidId(eventId) && (isSuperAdmin() || isPartnerUser(existing().partnerId));
    }
    
    match /events/{eventId}/guests/{guestId} {
      allow get: if isValidId(eventId) && isValidId(guestId); // Public could read own guest info if they have ticket code, handled by query?
      allow list: if isValidId(eventId); // Public can list guests for a known eventId (used for Greeting Screen)
      allow create: if isValidId(eventId) && isSignedIn() && isValidGuest(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (isSuperAdmin() || isPartnerUser(get(/databases/$(database)/documents/events/$(eventId)).data.partnerId) || isClientUser(get(/databases/$(database)/documents/events/$(eventId)).data.clientId));
      allow update: if isValidId(eventId) && isValidId(guestId) && isValidGuest(incoming()) && incoming().updatedAt == request.time &&
        incoming().eventId == existing().eventId &&
        (
          (isSuperAdmin() || isPartnerUser(get(/databases/$(database)/documents/events/$(eventId)).data.partnerId) || isClientUser(get(/databases/$(database)/documents/events/$(eventId)).data.clientId))
          ||
          (!isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['rsvpStatus', 'updatedAt']))
        );
      allow delete: if isValidId(eventId) && isValidId(guestId) && (isSuperAdmin() || isPartnerUser(get(/databases/$(database)/documents/events/$(eventId)).data.partnerId) || isClientUser(get(/databases/$(database)/documents/events/$(eventId)).data.clientId));
    }

    match /changelog/{entryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
