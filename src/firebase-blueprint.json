{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user (Admin or Client).",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "eventId": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Event": {
      "title": "Event",
      "description": "A wedding or special event managed by a client.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "clientUid": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired"] },
        "slug": { "type": "string" }
      },
      "required": ["title", "date", "location", "clientUid", "subscriptionStatus", "slug"]
    },
    "GuestEntry": {
      "title": "Guest Entry",
      "description": "A message left by a guest.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "message": { "type": "string" },
        "reply": { "type": "string" },
        "attendance": { "type": "string", "enum": ["hadir", "tidak_hadir", "ragu_ragu"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventId": { "type": "string" }
      },
      "required": ["name", "message", "attendance", "timestamp", "eventId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application configuration and settings.",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" }
      }
    },
    "Souvenir": {
      "title": "Souvenir",
      "description": "Souvenir item inventory per event.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "initialStock": { "type": "number" },
        "totalDistributed": { "type": "number" },
        "remainingStock": { "type": "number" },
        "physicalStockAudit": { "type": "number" },
        "lastAuditAt": { "type": "string" },
        "lastAuditBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["eventId", "name", "initialStock", "totalDistributed", "remainingStock"]
    },
    "SouvenirLog": {
      "title": "Souvenir Log",
      "description": "Audit trail log for souvenir distribution, returns, and adjustments.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "souvenirId": { "type": "string" },
        "souvenirName": { "type": "string" },
        "guestName": { "type": "string" },
        "quantity": { "type": "number" },
        "action": { "type": "string", "enum": ["TAKE", "RETURN", "ADJUSTMENT"] },
        "notes": { "type": "string" },
        "performedBy": { "type": "string" }
      },
      "required": ["eventId", "souvenirId", "souvenirName", "guestName", "quantity", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Event details."
    },
    "/events/{eventId}/souvenirs/{souvenirId}": {
      "schema": "Souvenir",
      "description": "Souvenir inventory items for this event."
    },
    "/events/{eventId}/souvenir_logs/{logId}": {
      "schema": "SouvenirLog",
      "description": "Distribution audit log for event souvenirs."
    },
    "/guests/{guestId}": {
      "schema": "GuestEntry",
      "description": "Guestbook entries."
    },
    "/settings/{docId}": {
      "schema": "Settings",
      "description": "System-wide settings documents like global, publicStats, and waTemplates."
    }
  }
}
